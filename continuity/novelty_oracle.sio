// M8 novelty oracle.
// admission.sio owns well-formedness. This executable owns only the finite
// classification of one phase against the frozen M5/M7 partition.
// It does not admit a proposal, reconstruct a tensor, or promote a claim.
//
// class_of[q] is the orbit class of quadratic code q. The 1024 entries were
// generated by the same affine action as the M7 explorer and checked against
// continuity/atlas_m7/orbit_classes_inventory.json. The executable decides
// membership by table lookup; Python does not choose the class.

fn bit_at(value: i64, coordinate: i64) -> i64 with Mut, Div {
    (value / shift(coordinate)) % 2
}

fn shift(n: i64) -> i64 with Mut {
    var p: i64 = 1
    var i: i64 = 0
    while i < n {
        p = p * 2
        i = i + 1
    }
    p
}

fn quadratic_code(phase: i64) -> i64 with Mut, Div {
    let d0 = bit_at(phase, 0)
    let d1 = bit_at(phase, 5)
    let d2 = bit_at(phase, 10)
    let d3 = bit_at(phase, 15)
    let a01 = (bit_at(phase, 1) + bit_at(phase, 4)) % 2
    let a02 = (bit_at(phase, 2) + bit_at(phase, 8)) % 2
    let a03 = (bit_at(phase, 3) + bit_at(phase, 12)) % 2
    let a12 = (bit_at(phase, 6) + bit_at(phase, 9)) % 2
    let a13 = (bit_at(phase, 7) + bit_at(phase, 13)) % 2
    let a23 = (bit_at(phase, 11) + bit_at(phase, 14)) % 2
    d0 + d1 * 2 + d2 * 4 + d3 * 8 + a01 * 16 + a02 * 32 + a03 * 64 + a12 * 128 + a13 * 256 + a23 * 512
}

